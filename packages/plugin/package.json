{
  "name": "@movabletype/mt-plugin-mt-rich-text-editor",
  "author": "Six Apart Ltd.",
  "license": "proprietary",
  "version": "0.0.1",
  "type": "module",
  "main": "index.js",
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@movabletype/app": "../../@movabletype/movabletype-app-0.0.1.tgz",
    "@movabletype/mt-rich-text-editor": "^0.0.1",
    "@movabletype/svelte-components": "../../@movabletype/movabletype-svelte-components-0.0.4.tgz",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "eslint": "^10.0.3",
    "eslint-plugin-svelte": "^3.15.1",
    "globals": "^15.6.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.5",
    "svelte-dnd-action": "^0.9.69",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "scripts": {
    "dev": "vite",
    "build:iife": "tsc && vite build",
    "build:es": "tsc && vite build --config vite.config.es.ts",
    "build": "tsc && npm run build:iife && npm run build:es",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check --cache \"mt-static/plugins/MTRichTextEditor/src/**/*.ts\"",
    "format:fix": "prettier --write --cache --cache-strategy metadata \"mt-static/plugins/MTRichTextEditor/src/**/*.ts\"",
    "test:unit": "vitest",
    "test:all": "npm run test:unit"
  },
  "description": ""
}
